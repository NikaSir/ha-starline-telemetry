{
  "panel": "starline",
  "route": "/starline",
  "version": "0.7.0-beta005",
  "entry_module": "starline-app.js",
  "web_component": "starline-app-panel",
  "ui_standard": "2.2",
  "runtime_architecture": "single_stable_component_point_patching",
  "home_assistant_menu_event": "hass-toggle-menu",
  "zoom": {
    "engine": "transform",
    "state": [
      "scale",
      "x",
      "y"
    ],
    "target": "workspace_only",
    "min_percent": 75,
    "max_percent": 200,
    "controls": "gesture_only",
    "native_scroll_at_100": true,
    "pan_above_percent": 100,
    "axis_lock_when_fitted": true,
    "native_vertical_scroll_at_or_below_percent": 100,
    "one_finger_pan": "above_100_percent_on_overflowing_axes_only",
    "offsets_at_or_below_100_percent": {
      "x": 0,
      "y": 0
    },
    "fit_axis_offset": 0,
    "tab_switch_scroll": "top",
    "reset": "two_finger_double_tap",
    "snap_percent_range": [
      97,
      103
    ],
    "feedback": "Масштаб 100%",
    "persistence": "separate_overview_and_per_vehicle_keys"
  },
  "typography": {
    "reference": "official_starline_mobile_app",
    "minimum": "not_smaller_than_corresponding_reference_text",
    "responsive_reduction_below_reference": false,
    "floors_px": {
      "compact_label": 11,
      "standard_secondary_text": 12,
      "summary_value": 14,
      "view_title": 21,
      "history_date_and_time": 16,
      "history_action": 18
    }
  },
  "shell": {
    "header": {
      "columns": "52px minmax(0,1fr) 52px",
      "phone_min_height_px": 60,
      "top_safe_area": "env(safe-area-inset-top)",
      "control_size_px": 44,
      "control_radius_px": 16,
      "icon_size_px": 25,
      "title_px": 23,
      "subtitle_px": 14,
      "title_width": "min(360px,100%)",
      "title_height_px": 52
    },
    "bottom_navigation": {
      "body_height_px": 64,
      "button_height_px": 52,
      "icon_size_px": 26,
      "label_size_px": 12,
      "label_weight": 700
    },
    "peer_selector": {
      "body_height_px": 52,
      "button_height_px": 44,
      "status_lamp_px": 9,
      "selection_state_independent": true,
      "visible_on": [
        "history",
        "trips",
        "diagnostics"
      ]
    },
    "host_boundary": "ha-panel",
    "content_max_width_px": 1280,
    "scroll_boundary_guard": "capture-non-passive-touchmove"
  },
  "summary": {
    "vehicle_cards": "simultaneous_overview",
    "vehicle_order": [
      "130",
      "683"
    ],
    "phone_portrait_layout": "stacked",
    "phone_portrait_target": "both_cards_visible_at_100_percent_with_details_collapsed",
    "primary_metrics": [
      "fuel",
      "battery",
      "engine_running",
      "security"
    ],
    "perimeter_roles": [
      "door",
      "hood",
      "trunk"
    ],
    "secondary_metrics_location": "expandable_vehicle_details",
    "vehicle_images": "matched_static_portraits",
    "metric_tile_layout": "bold_centered_label_above_centered_icon_value_row",
    "metric_label_weight": 750,
    "metric_reading_alignment": "icon_and_value_same_line_centered",
    "security_states": {
      "armed": "Охрана / Включена",
      "disarmed": "Охрана / Снята",
      "alarm": "Охрана / Тревога",
      "stale": "Охрана / Устарело",
      "unknown": "Охрана / Нет данных"
    },
    "armed_source_priority": [
      "lock",
      "armed",
      "security",
      "arm",
      "guard"
    ],
    "security_conflict_policy": "first_reliable_home_assistant_source_wins",
    "security_current_source": "home_assistant_then_fresh_bootstrap_60_seconds",
    "freshness_source": "home_assistant_last_reported_then_last_updated",
    "freshness_max_age_minutes": 30,
    "timestamp_timezone": "Europe/Moscow",
    "data_quality": [
      "fresh",
      "stale",
      "unavailable"
    ]
  },
  "history": {
    "preferred_source": "official_starline_open_api_events",
    "fallback_source": "home_assistant_recorder_state_transitions",
    "preferred_time": "starline_event_timestamp",
    "fallback_time": "home_assistant_detection_timestamp"
  },
  "navigation": {
    "title_action": "return_to_hierarchical_parent",
    "parent_route": "/home/overview",
    "history_back_used": false
  },
  "rendering": {
    "shell_mount": "once",
    "telemetry_update": "requestAnimationFrame_point_patch",
    "view_cache": "lazy_per_view_and_vehicle",
    "unchanged_image_src_reassigned": false
  },
  "assets": [
    "assets/starline-car-130-v2.webp",
    "assets/starline-car-683-v2.webp"
  ],
  "diagnostics": {
    "fuel_calibration": {
      "write_access": "home_assistant_admin",
      "storage": "home_assistant_per_starline_device",
      "source_unit": "%",
      "minimum_compatible_full_refuels": 3,
      "model": "median_full_percentage_with_receipt_consistency_checks",
      "vehicle_commands": false
    }
  }
}

{
  "panel": "starline",
  "route": "/starline",
  "version": "0.6.4",
  "entry_module": "starline-app.js",
  "web_component": "starline-app-panel",
  "ui_standard": "1.9",
  "runtime_architecture": "single_stable_component_point_patching",
  "home_assistant_menu_event": "hass-toggle-menu",
  "zoom": {
    "engine": "transform",
    "state": [
      "scale",
      "x",
      "y"
    ],
    "target": "workspace_only",
    "min_percent": 75,
    "max_percent": 200,
    "controls": "gesture_only",
    "native_scroll_at_100": true,
    "pan_above_percent": 100,
    "axis_lock_when_fitted": true,
    "native_vertical_scroll_at_or_below_percent": 100,
    "one_finger_pan": "above_100_percent_on_overflowing_axes_only",
    "offsets_at_or_below_100_percent": {
      "x": 0,
      "y": 0
    },
    "fit_axis_offset": 0,
    "tab_switch_scroll": "top",
    "reset": "two_finger_double_tap",
    "snap_percent_range": [
      97,
      103
    ],
    "feedback": "Масштаб 100%",
    "persistence": "per_panel_client_and_vehicle"
  },
  "typography": {
    "reference": "official_starline_mobile_app",
    "minimum": "not_smaller_than_corresponding_reference_text",
    "responsive_reduction_below_reference": false,
    "floors_px": {
      "compact_label": 11,
      "standard_secondary_text": 12,
      "summary_value": 14,
      "view_title": 21,
      "history_date_and_time": 16,
      "history_action": 18
    }
  },
  "shell": {
    "header": {
      "columns": "52px minmax(0,1fr) 52px",
      "phone_min_height_px": 60,
      "top_safe_area": "env(safe-area-inset-top)",
      "control_size_px": 44,
      "control_radius_px": 16,
      "icon_size_px": 25,
      "title_px": 23,
      "subtitle_px": 14
    },
    "bottom_navigation": {
      "minimum_target_height_px": 52,
      "icon_size_px": 28,
      "label_size_px": 12
    }
  },
  "summary": {
    "vehicle_switcher": "fixed_two_page_selector",
    "vehicle_cards": "selected_one_per_page",
    "vehicle_page_order": [
      "130-й",
      "683-й"
    ],
    "operational_order": [
      "engine_running",
      "last_event",
      "parking"
    ],
    "last_event_width": "expanded_from_parking_column",
    "connection_position": "left_free_scene",
    "scene_height": "fills_available_summary_viewport",
    "security_states": {
      "armed": "Охрана / Включена",
      "disarmed": "Охрана / Снята",
      "alarm": "Охрана / Тревога",
      "unknown": "Охрана / Нет данных"
    },
    "state_scene_image_priority": [
      "hood_open",
      "trunk_open",
      "doors_open",
      "engine_running",
      "default"
    ],
    "armed_source_priority": [
      "lock",
      "armed",
      "security",
      "arm",
      "guard"
    ],
    "security_conflict_policy": "any_explicit_armed_source_wins",
    "security_current_source": "starline_open_api_cached_60_seconds",
    "refresh_behavior": "force_current_read_only_vehicle_state",
    "vehicle_geometry": {
      "mode": "visible_alpha_frame",
      "visible_width_percent": 72,
      "proportion_reference_vehicle": "683",
      "reference_visible_size_by_state": {
        "default": [1824, 793],
        "engine": [1866, 843],
        "door_open": [1862, 840],
        "hood_open": [1692, 825],
        "trunk_open": [1599, 820]
      },
      "horizontal": "visible_alpha_center",
      "wheel_line_bottom_px": 167,
      "narrow_wheel_line_bottom_px": 161,
      "state_assets_share_geometry_model": true
    },
    "scene_height_source": "remaining_fixed_shell_grid_viewport",
    "status_row_height_px": 74,
    "status_value_lines": 2,
    "operational_columns": ["1fr", "1.35fr", ".65fr"],
    "operational_value_layout": "icon_with_aligned_label_and_value",
    "security_field_lower_edge": "open_and_faded",
    "security_field_geometry": "grounded_half_dome_open_at_wheel_line",
    "state_scene_overlays": [
      "armed_field",
      "alarm_field",
      "offline_desaturation"
    ]
  },
  "history": {
    "preferred_source": "official_starline_open_api_events",
    "fallback_source": "home_assistant_recorder_state_transitions",
    "preferred_time": "starline_event_timestamp",
    "fallback_time": "home_assistant_detection_timestamp"
  },
  "navigation": {
    "title_action": "return_to_safe_originating_base_panel",
    "allowed_base_routes": [
      "/dashboard-house-v11/home",
      "/dashboard-actions/home",
      "/dashboard-infrastructure/overview"
    ],
    "history_back_used": false
  },
  "rendering": {
    "shell_mount": "once",
    "telemetry_update": "requestAnimationFrame_point_patch",
    "view_cache": "lazy_per_view_and_vehicle",
    "unchanged_image_src_reassigned": false
  },
  "assets": [
    "assets/starline-bg-130-v2.webp",
    "assets/starline-bg-683-v2.webp",
    "assets/starline-car-130-v2.webp",
    "assets/starline-car-683-v2.webp",
    "assets/starline-car-130-engine-v1.webp",
    "assets/starline-car-130-door-open-v1.webp",
    "assets/starline-car-130-hood-open-v1.webp",
    "assets/starline-car-130-trunk-open-v1.webp",
    "assets/starline-car-683-engine-v1.webp",
    "assets/starline-car-683-door-open-v1.webp",
    "assets/starline-car-683-hood-open-v1.webp",
    "assets/starline-car-683-trunk-open-v1.webp"
  ]
}

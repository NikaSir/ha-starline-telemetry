{
  "panel": "starline",
  "route": "/starline",
  "version": "0.5.4",
  "ui_standard": "1.7",
  "entry_module": "starline-app.js",
  "web_component": "starline-app-panel",
  "home_assistant_menu_event": "hass-toggle-menu",
  "zoom": {
    "engine": "transform",
    "state": [
      "scale",
      "x",
      "y"
    ],
    "target": "workspace_only",
    "min_percent": 75,
    "max_percent": 200,
    "controls": "gesture_only",
    "native_scroll_at_100": true,
    "pan_above_percent": 100,
    "axis_lock_when_fitted": true,
    "native_vertical_scroll_at_or_below_percent": 100,
    "one_finger_pan": "above_100_percent_on_overflowing_axes_only",
    "offsets_at_or_below_100_percent": {
      "x": 0,
      "y": 0
    },
    "fit_axis_offset": 0,
    "tab_switch_scroll": "top",
    "reset": "two_finger_double_tap",
    "snap_percent_range": [
      97,
      103
    ],
    "feedback": "Масштаб 100%"
  },
  "typography": {
    "reference": "official_starline_mobile_app",
    "minimum": "not_smaller_than_corresponding_reference_text",
    "responsive_reduction_below_reference": false,
    "meaningful_min_px": 12,
    "meaningful_max_px": 25,
    "schematic_exception_px": [
      9,
      10
    ],
    "floors_px": {
      "compact_label": 12,
      "standard_secondary_text": 12,
      "summary_value": 14,
      "view_title": 21,
      "history_date_and_time": 16,
      "history_action": 18
    }
  },
  "shell": {
    "header": {
      "center_action": "return_to_source_base_panel",
      "source_route_handoff_key": "nikas.specialized.source_route.v1",
      "browser_history_back_allowed": false,
      "columns": "52px minmax(0,1fr) 52px",
      "phone_min_height_px": 60,
      "control_size_px": 44,
      "control_radius_px": 16,
      "icon_size_px": 25,
      "title_px": 23,
      "subtitle_px": 14,
      "narrow_title_px": 21,
      "narrow_subtitle_px": 13
    },
    "bottom_navigation": {
      "minimum_target_height_px": 52,
      "icon_size_px": 28,
      "label_size_px": 12
    }
  },
  "rendering": {
    "stable_dom": true,
    "routine_shadow_root_replacement": false,
    "telemetry_updates": "animation_frame_coalesced_point_patch",
    "view_cache": "lazy_reuse_same_subtree",
    "persistent_layers": [
      "header",
      "peer_selector",
      "zoom_viewport",
      "work_canvas",
      "bottom_navigation"
    ]
  },
  "connection_freshness_indicator": {
    "enabled": false,
    "reason": "not_requested_for_starline"
  },
  "summary": {
    "vehicle_switcher": "hidden",
    "vehicle_cards": "all",
    "operational_order": [
      "engine_running",
      "last_event",
      "parking"
    ],
    "last_event_width": "expanded_from_parking_column",
    "connection_position": "left_free_scene",
    "scene_height": "fills_available_summary_viewport",
    "security_states": {
      "armed": "Охрана / Включена",
      "disarmed": "Охрана / Снята",
      "alarm": "Охрана / Тревога"
    }
  },
  "history": {
    "preferred_source": "official_starline_open_api_events",
    "fallback_source": "home_assistant_recorder_state_transitions",
    "preferred_time": "starline_event_timestamp",
    "fallback_time": "home_assistant_detection_timestamp"
  },
  "assets": [
    "assets/starline-bg-130-v2.webp",
    "assets/starline-bg-683-v2.webp",
    "assets/starline-car-130-v2.webp",
    "assets/starline-car-683-v2.webp"
  ]
}
